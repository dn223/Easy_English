# Clave de la API de Claude para la tutora de conversación (/tutor).
# Consíguela en https://platform.claude.com y cópiala en un archivo .env.local.
ANTHROPIC_API_KEY=

# Opcional: modelo de la tutora. Por defecto claude-opus-5-5.
# TUTOR_MODEL=claude-opus-5-5

# Opcional: voces naturales para el audio (Google Cloud Text-to-Speech).
# Sin esta clave se usa la voz del navegador.
# GOOGLE_TTS_API_KEY=
# TTS_VOICES=en-US-Neural2-F,en-US-Neural2-D,en-US-Neural2-H
